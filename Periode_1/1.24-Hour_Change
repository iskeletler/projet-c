int main()
{
    int heure;
    int minutes;
    int secondes;

    printf("definissez votre heure: \n");

    printf("Heure: ");
    scanf("%d", &heure);

    printf("Minutes: ");
    scanf("%d", &minutes);

    printf("Secondes: ");
    scanf("%d", &secondes);

    if ((heure >= 0 && heure <= 23) && (minutes >= 0 && minutes <= 59) && (secondes >= 0 && secondes <= 59))
    {
        secondes++;
        if (secondes == 60)
        {
            secondes = 0;
            minutes++;
            if (minutes == 60)
            {
                minutes = 0;
                heure++;
                if (heure == 24)
                {
                    heure = 0;
                }
            }
        }
            printf("lheure actuel est : %d heure %d minutes %d secondes \n", heure, minutes, secondes);
    }
    else
    {
        printf("INVALID");
    }
    return 0;
}
